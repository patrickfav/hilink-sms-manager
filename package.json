{
  "name": "hilink-sms-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:mock": "cd backend && go run ./cmd/mock-hilink",
    "dev:backend": "cd backend && go run github.com/air-verse/air@v1.61.7 -c .air.toml",
    "dev:frontend": "vite --host 127.0.0.1",
    "build:frontend": "vite build && mkdir -p backend/web/dist && cp -R frontend-dist/. backend/web/dist/",
    "build": "pnpm build:frontend && mkdir -p dist && cd backend && go build -trimpath -ldflags='-s -w' -o ../dist/hilink-sms ./cmd/server",
    "test": "pnpm test:go && vitest run",
    "test:go": "cd backend && go test ./...",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-preact": "^1.72.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
